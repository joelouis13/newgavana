# Copy to .env.local and fill in from Supabase → Project Settings → API.

# Public (safe in the browser — access is limited by Row Level Security)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Your live site address, used in WhatsApp product links, sitemap and SEO tags.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# SECRET — only used by `npm run seed` on your machine. Never prefix with
# NEXT_PUBLIC_ and never add it to your hosting provider's environment.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
